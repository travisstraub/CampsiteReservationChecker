# Install: sudo cp deploy/campsite-checker.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now campsite-checker
[Unit]
Description=ReserveCalifornia campsite availability checker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=campsite
WorkingDirectory=/opt/campsite-checker
ExecStart=/opt/campsite-checker/.venv/bin/python campsite_checker.py -c /opt/campsite-checker/config.toml
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
